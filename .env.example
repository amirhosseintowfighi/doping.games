# ── required ────────────────────────────────────────────────
# Public address of the site (payment callbacks come back here).
APP_URL=https://doping.games
# Database password used by docker-compose (and inside DATABASE_URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Encryption key ring for router passwords, RCON passwords and WireGuard private keys.
# Generate a key with:  openssl rand -base64 32
DOPING_KMS_KEYS=k2026:REPLACE_WITH_32_BYTE_BASE64_KEY
DOPING_KMS_ACTIVE=k2026
# First admin account, created on the first start when no admin exists (password ≥ 12 characters).
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── payments ────────────────────────────────────────────────
# Without a merchant id the site runs a built-in TEST gateway (no real money).
ZARINPAL_MERCHANT_ID=
# live | sandbox
PAYMENT_MODE=live

# ── optional ────────────────────────────────────────────────
# DATABASE_URL=postgres://user:pass@host:5432/doping   (set automatically by docker-compose)
# COOKIE_SECURE=true          # default true in production; false only for plain-http testing
# TRUST_PROXY=true            # read the client IP from X-Real-IP / X-Forwarded-For
# REGISTRATION=true           # false = invite-only, accounts created by admins
# WORKERS=true                # quota + game-server polling inside this process
# QUOTA_INTERVAL_SEC=300      # how often router queue counters are read
# SERVER_POLL_SEC=30          # how often game servers are queried (A2S)
